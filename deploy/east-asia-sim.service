[Unit]
Description=East Asia classroom simulation (Flask + gunicorn)
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/AMES-sino
EnvironmentFile=/home/ubuntu/AMES-sino/.env
# -w 1 is mandatory: all app state lives in a single in-memory dict;
# more workers would split the game across processes.
ExecStart=/home/ubuntu/AMES-sino/.venv/bin/gunicorn -w 1 --threads 4 -b 127.0.0.1:8000 app:app
Restart=always

[Install]
WantedBy=multi-user.target
